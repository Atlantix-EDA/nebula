# Universal Vivado Project Template
# Generated by Nebula - Project: {{ proj_name }}
# Auto-detected {{ sv_file_count }} SystemVerilog files

# Create project (force overwrite if exists)
create_project {{ proj_name }} {{ target_dir }} -part {{ part }} -force

# Set project properties
set_property target_language Verilog [current_project]
set_property simulator_language Mixed [current_project]

{% if sv_files %}
# Add SystemVerilog source files
{% for file in sv_files %}
add_files -norecurse {{ "{" }}{{ file }}{{ "}" }}
{% endfor %}

# Set file properties for SystemVerilog
set_property file_type SystemVerilog [get_files]

# Set top module (auto-detect from first file or use project name as fallback)
{% if sv_files %}
# Let Vivado auto-detect the top module from the loaded files
set_property top_auto_set true [current_fileset]
{% else %}
set_property top {{ proj_name }} [current_fileset]
{% endif %}
{% endif %}

{% if include_tcl_files %}
# Include additional TCL files (e.g., block designs)
{% for tcl_file in include_tcl_files %}
source {{ tcl_file }}
{% endfor %}

# Generate output products and an HDL wrapper for every block design the
# sourced scripts created, so RTL tops can instantiate <bd_name>_wrapper.
# Nested sub-designs (e.g. inside SmartConnect) have a parent composite
# file and may only be generated by their parent -- skip them.
# No-op when the project contains no .bd files.
foreach bd_file [get_files -quiet *.bd] {
    if { [get_property -quiet PARENT_COMPOSITE_FILE $bd_file] ne "" } { continue }
    generate_target all $bd_file
    make_wrapper -files $bd_file -top -import
}
update_compile_order -fileset sources_1
{% endif %}

{% if elf_path_file and elf_path_file != "{}" %}
# Associate the ELF with embedded processors inside the block design(s) so
# write_bitstream initializes the local memory with the program image.
add_files -norecurse {{ elf_path_file }}
foreach bd_file [get_files -quiet *.bd] {
    if { [get_property -quiet PARENT_COMPOSITE_FILE $bd_file] ne "" } { continue }
    catch { open_bd_design $bd_file }
    set procs [get_bd_cells -quiet -filter {VLNV =~ "*:ip:microblaze*"}]
    if { [llength $procs] > 0 } {
        set proc_names {}
        foreach p $procs { lappend proc_names [string trimleft [get_property PATH $p] /] }
        set bd_name [file rootname [file tail $bd_file]]
        set_property SCOPED_TO_REF $bd_name [get_files {{ elf_path_file }}]
        set_property SCOPED_TO_CELLS $proc_names [get_files {{ elf_path_file }}]
        puts "NEBULA: ELF scoped to BD '$bd_name' cells '$proc_names'"
    }
}
{% endif %}

{% if constraints_files %}
# Add constraints files
{% for constraints_file in constraints_files %}
add_files -fileset constrs_1 {{ constraints_file }}
{% endfor %}
{% endif %}

{% if ip_files %}
# Import Xilinx IP files
{% for ip_file in ip_files %}
import_ip {{ ip_file }}
{% endfor %}

# Upgrade IP to current Vivado version
upgrade_ip [get_ips]
{% endif %}

{% if compile %}
# Run synthesis
launch_runs synth_1 -jobs 8
wait_on_run synth_1

# Run implementation
launch_runs impl_1 -jobs 8
wait_on_run impl_1

# Generate bitstream
launch_runs impl_1 -to_step write_bitstream -jobs 8
wait_on_run impl_1
{% endif %}

{% if open_gui %}
# Open GUI
start_gui
{% endif %}